{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings && bun scripts/check-slop.ts && oxfmt --check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:api": "bun scripts/generate-api-types.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hackcove/theme-catppuccin-mocha": "^0.2.6",
    "@hackcove/theme-thrifty-paper": "^0.1.5",
    "@hackcove/ui": "^0.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
