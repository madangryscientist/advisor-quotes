# Copy to .env. docker compose reads it; the API reads the connection string from the environment.
POSTGRES_DB=quotes
POSTGRES_USER=quotes
POSTGRES_PASSWORD=quotes
POSTGRES_PORT=5432

# ASP.NET Core maps ConnectionStrings__Quotes to configuration key ConnectionStrings:Quotes.
ConnectionStrings__Quotes=Host=localhost;Port=5432;Database=quotes;Username=quotes;Password=quotes

# Apply EF migrations when the API starts. On for local development, off everywhere the schema is managed another way.
Database__MigrateOnStartup=true

# Write about eight demo quotes, through the domain and Pricing, when the quotes table is empty. Dev only: tests and e2e leave it off.
Database__SeedDemoData=true

# Where the web app's server functions reach the API. Server-only: never a VITE_ variable.
QUOTES_API_URL=http://localhost:5180

# Tracing, read by the API and the web app. Unset, nothing is exported. Every API response carries X-Trace-Id either way.
# Set it to the Aspire dashboard (docker compose --profile observability up -d; UI at http://localhost:18888); spans and log records both go there.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=advisor-quotes-api
# Both apps send finished spans in batches every 5 s by default; 500 makes a trace show up within a second.
# OTEL_BSP_SCHEDULE_DELAY=500
# OTEL_BLRP_SCHEDULE_DELAY=500

# Integration tests (apps/api-integration-tests). Unset, they skip. Its own database; EF creates it on the first run.
# ConnectionStrings__QuotesIntegration=Host=localhost;Port=5432;Database=quotes_it;Username=quotes;Password=quotes
